rules_version = '2';

// ══════════════════════════════════════════════════════════════
//  gccrc-crae — 세 수업이 한 프로젝트를 나눠 쓴다.
//  이 파일이 유일한 원본이다. 콘솔에서 직접 고치지 말 것.
//
//    배포:  firebase deploy --only firestore:rules
//    맨 `firebase deploy` 는 치지 않는다 — 호스팅은 버셀이 맡는다.
//    그냥 배포하면 이 파일에 없는 규칙이 전부 지워진다.
//
//    HCI와 커뮤니케이션   runs · time · presence · hci4_* · hci5_* · hci6_*
//    지능형콘텐츠         icp_teams · icp3_* · icp5_*
//
//  수업을 새로 붙일 때는 접두사를 하나 정하고 블록을 여기에 덧붙인다.
// ══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    /* ══ HCI와 커뮤니케이션 ═══════════════════════════════════ */

    // 2주차 1988년 거실 — 실습 기록.
    // 로그인(익명)한 사람만 남길 수 있고, 고치거나 지울 수 없다.
    match /runs/{id} {
      allow create: if request.auth != null
                    && request.resource.data.team is string
                    && request.resource.data.name is string
                    && request.resource.data.team.size() < 30
                    && request.resource.data.name.size() < 30;
      allow read:   if request.auth != null;
      allow update, delete: if false;
    }

    // 3주차 활자의 문 — 조 단위 기록. 남기기만 하고 고치거나 지울 수 없다.
    match /time/{id} {
      allow create: if request.auth != null
                    && request.resource.data.team is string
                    && request.resource.data.team.size() < 30;
      allow read:   if request.auth != null;
      allow update, delete: if false;
    }

    // 2·3주차 — 지금 어느 스테이션에 있는지. 자기 것만 쓴다.
    match /presence/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    /* ── 4주차 노만의 공방 ────────────────────────────────────
       포인트가 과제 점수에 걸린다. 그래서 돈이 움직이는 모음은
       학생 브라우저에서 한 글자도 못 쓰게 막고, 버셀 함수만 쓴다.
       Admin SDK 는 이 규칙을 통과하므로 write:false 라도 서버는 쓸 수 있다. */

    match /hci4_wallets/{team} {          // 조별 포인트와 재고
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /hci4_ledger/{id} {             // 장부 — 모든 거래
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /hci4_shop/{id} {               // 상점 카탈로그
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /hci4_works/{id} {              // 출품작과 품평 결과
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // 블록 배치 자동저장 — 돈과 무관하므로 조가 직접 쓴다.
    match /hci4_drafts/{team} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && team.size() > 0 && team.size() < 40;
    }

    // 지금 어느 조가 무엇을 하고 있는지 — 자기 것만 쓴다.
    // 3주차 현황판에 4주차 학생이 섞이지 않게 모음을 따로 둔다.
    match /hci4_presence/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    /* ── 5주차 앱 공방 ────────────────────────────────────────
       단계 · 조의 앱 · 생성 횟수는 버셀 함수(api/appshop.js)만 쓴다. 학생은 읽기만.
       설계서 초안은 제작 단계에서만, 평가는 평가 단계에서만 학생이 직접 쓴다. */
    function hci5Phase() {
      return get(/databases/$(database)/documents/hci5_state/current).data.phase;
    }
    match /hci5_state/{doc} {             // 지금 단계 · 제작 마감 시각
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /hci5_teams/{id} {              // 조의 앱 · 생성 횟수 · 출판본
      allow read:  if request.auth != null;
      allow write: if false;
      match /versions/{v} {               // 생성할 때마다의 설계서와 앱
        allow read:  if request.auth != null;
        allow write: if false;
      }
    }
    // 시연(T21)은 학생이 시작하기 전 준비 단계에서도 설계서를 쓸 수 있다
    function hci5Open(id) {
      return !exists(/databases/$(database)/documents/hci5_state/current)
               ? id == "T21"
               : (hci5Phase() == "build" || (id == "T21" && hci5Phase() == "ready"));
    }
    match /hci5_specs/{id} {              // 설계서 초안 — 출판 뒤에는 잠긴다
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && hci5Open(id)
                   && id.matches('T[0-9]{2}')
                   && request.resource.data.keys().hasOnly(['spec', 'updatedAt', 'by'])
                   && request.resource.data.by == request.auth.uid;
    }
    match /hci5_evals/{id} {              // 평가 — 남기기만 하고 고치거나 지울 수 없다
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && hci5Phase() == "eval"
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 30
                    && request.resource.data.tags is list
                    && request.resource.data.tags.size() <= 40;
      allow update, delete: if false;
    }

    /* ── 6주차 VR · AR 적용 판단 실습 (vrcard/) ──────────────────
       단계는 버셀 함수(api/vrcard.js)만 쓴다. 나머지는 학생이 직접 쓰되 단계마다 한 가지만 열린다.
         분류(sort)        — 조의 분류판
         재설계(design)    — 조의 설계안 (스케치는 jpeg 데이터 주소, 크기 제한)
         부작용 찾기(side)  — 다음 번호 조의 설계안에 붙이는 부작용
         대응책(reply)     — 받은 부작용 문서에 대응책만 덧붙인다 */
    function hci6Phase() {
      return get(/databases/$(database)/documents/hci6_state/current).data.phase;
    }
    match /hci6_state/{doc} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /hci6_boards/{id} {             // 조의 분류판 — 카드마다 칸 · 경고 · 이론 · 이유
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && hci6Phase() == "sort"
                   && id.matches('T[0-9]{2}')
                   && request.resource.data.keys().hasOnly(['cards', 'updatedAt', 'by'])
                   && request.resource.data.by == request.auth.uid
                   && request.resource.data.cards.size() <= 30;
    }
    match /hci6_designs/{id} {            // 조의 재설계안
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && hci6Phase() == "design"
                   && id.matches('T[0-9]{2}')
                   && request.resource.data.keys().hasOnly(['card', 'kind', 'who', 'pain', 'change', 'theory', 'checks', 'sketch', 'updatedAt', 'by'])
                   && request.resource.data.by == request.auth.uid
                   && (!('sketch' in request.resource.data) || request.resource.data.sketch.size() < 700000);
    }
    match /hci6_mockups/{id} {           // 조의 화면 목업 — 버셀 함수(api/vrcard.js)만 쓴다
      allow read:  if request.auth != null;
      allow write: if false;
      match /versions/{v} {
        allow read:  if request.auth != null;
        allow write: if false;
      }
    }
    match /hci6_sides/{id} {              // 「받는 조_붙이는 조」 — 부작용과 대응책
      allow read:  if request.auth != null;
      allow create, update: if request.auth != null
                    && id.matches('T[0-9]{2}_T[0-9]{2}')
                    && hci6Phase() == "side"
                    && request.resource.data.keys().hasOnly(['target', 'from', 'items', 'by', 'updatedAt'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.items is list
                    && request.resource.data.items.size() <= 12;
      allow update: if request.auth != null
                    && hci6Phase() == "reply"
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies', 'replyBy', 'repliedAt'])
                    && request.resource.data.replyBy == request.auth.uid;
      allow delete: if false;
    }

    /* ══ 지능형콘텐츠 ════════════════════════════════════════ */

    // 2주차 · 모듈 조립대
    match /icp_teams/{teamId} {
      allow read, write: if request.auth != null
                         && teamId.size() > 0 && teamId.size() < 40;
    }

    // 3주차 · 검색 교환대 (week03/)
    //
    // 조끼리 서로 읽어야 하는 실습이다. 플랫폼 조는 검색엔진 조의 표를
    // 검색해야 하고, 검색엔진 조는 플랫폼 조의 명세서를 읽어야 한다.
    // 그래서 이 여섯 모음은 로그인한 사람이면 모두 읽고 쓸 수 있다.
    // 민감한 내용은 넣지 않는다 — 한 방에 있는 학생들끼리 보는 실습판이다.
    match /icp3_config/{id} { allow read, write: if request.auth != null; }
    match /icp3_teams/{id}  { allow read, write: if request.auth != null; }  // 역할·저장방식
    match /icp3_data/{id}   { allow read, write: if request.auth != null; }  // 검색엔진 조의 표
    match /icp3_specs/{id}  { allow read, write: if request.auth != null; }  // 플랫폼 조의 명세서
    match /icp3_reqs/{id}   { allow read, write: if request.auth != null; }  // 요청과 답
    match /icp3_wb/{id}     { allow read, write: if request.auth != null; }  // 워크북

    // 5주차 · 뉴스레터 플랫폼 (week05/)
    //
    // 독자 화면은 모든 조의 콘텐츠 중에서 고른다. 그래서 조끼리 서로 읽어야 한다.
    // 변형을 만드는 AI 호출은 버셀 함수(api/enrich.js)가 하고, 키는 거기에만 있다.
    match /icp5_config/{id} { allow read, write: if request.auth != null; }  // 단계
    match /icp5_teams/{id}  { allow read, write: if request.auth != null; }  // 조와 프롬프트
    match /icp5_items/{id}  { allow read, write: if request.auth != null; }  // 콘텐츠와 변형

    /* ═══════════════════════════════════════════════════════ */

    match /{document=**} { allow read, write: if false; }
  }
}
