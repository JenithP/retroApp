{
  "outputDirectory": "public",
  "functions": { "api/judge.js": { "maxDuration": 15 } },
  "redirects": [
    { "source": "/", "destination": "/time/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(glb|webp|png|jpg|mp3|mp4)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/time/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
